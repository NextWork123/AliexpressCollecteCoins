# === AliExpress account (REQUIRED) ===
ALIEXPRESS_EMAIL=your_email@example.com
ALIEXPRESS_PASSWORD=your_password

# === Scheduling ===
# The container stays active: first collection on start, then every 24h at
# the same time the previous collection was taken (persisted in /data).
RUN_ON_SCHEDULE=1
TZ=Europe/Rome
# Optional: random offset of 0-JITTER_MINUTES minutes added to the daily time
# JITTER_MINUTES=0

# === Optional settings ===
# HEADLESS=true             # set to "false" to watch the browser (local dev only)
# MAX_ATTEMPTS=3            # max full collection cycles per run
# COIN_URL=https://s.click.aliexpress.com/e/_DB2kEjh
